{
  "appId": "app.eliteathlete",
  "appName": "Elite Athlete",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0D0D0D",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0D0D0D"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    }
  }
}
