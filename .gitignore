node_modules/
dist/
.env.local
.env
*.local

# Local Netlify folder
.netlify

resend api key.txt
*.txt
stripe cupon id.txt
# The blanket *.txt above is deliberate -- it catches stray secret/scratch text
# files. But it also swallowed every requirements.txt, so a fresh clone could not
# rebuild the scraper Python envs. Re-include dependency manifests only.
# (Must stay AFTER *.txt: within one .gitignore, the last matching pattern wins.)
!**/requirements*.txt
Assets/
.netlify/
.env.local
android/app/build/.env.local.save
.env*.save
.DS_Store

keystore.properties

android/keystore.properties

_backups/

# Staging area for dead folders pending manual deletion, and vite temp files
_to_delete/
vite.config.js.timestamp-*.mjs

# Coach scraper: regenerable artifacts, not source.
# archive.sqlite is a 29MB compressed HTML cache; out/ is generated CSV/SQL.
tools/coach-scraper/data/
tools/coach-scraper/out/

# HS scraper: same pattern -- regenerable artifacts, not source.
tools/hs-scraper/data/
tools/hs-scraper/out/

# Python bytecode cache, wherever it turns up.
__pycache__/
*.pyc
